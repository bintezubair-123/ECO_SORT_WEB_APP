# Groq API Configuration
# Get your API key from: https://console.groq.com

GROQ_API_KEY="your api key here"

# Vision Model Name
# Use a current Groq vision model. Examples:
# - llama-2-vision-13b (check current availability)
# Visit https://console.groq.com/docs/models for the latest vision models

GROQ_MODEL=openai/gpt-oss-20b
